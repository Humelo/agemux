class Agemux < Formula
  desc "Persistent Codex, Claude, and Grok sessions with built-in account views"
  homepage "https://github.com/Humelo/agemux"
  url "https://github.com/Humelo/agemux/archive/refs/tags/v0.1.26.tar.gz"
  sha256 "5239407ff74ecff105906640f749879c73fa9b5fcfafd462f8960b7ac34efe84"
  license "MIT"

  depends_on "go" => :build
  depends_on "shpool"

  def install
    system "go", "build", *std_go_args(output: bin/"agemux"), "./cmd/agemux"
  end

  test do
    assert_match "agemux", shell_output("#{bin}/agemux --help")
    assert_match "Claude accounts 0.1.26", shell_output("#{bin}/agemux claude-accounts version")
  end
end
