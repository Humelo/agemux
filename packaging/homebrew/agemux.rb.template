class Agemux < Formula
  desc "Persistent Codex, Claude, and Grok sessions with built-in account views"
  homepage "https://github.com/Humelo/agemux"
  url "https://github.com/Humelo/agemux/archive/refs/tags/v0.1.25.tar.gz"
  sha256 "f4e6e234553fd226ceec6e13594d6c6a0aa064c5477687e4c879c48ecfa4080a"
  license "MIT"

  depends_on "go" => :build
  depends_on "shpool"

  def install
    system "go", "build", *std_go_args(output: bin/"agemux"), "./cmd/agemux"
  end

  test do
    assert_match "agemux", shell_output("#{bin}/agemux --help")
    assert_match "Claude accounts 0.1.25", shell_output("#{bin}/agemux claude-accounts version")
  end
end
