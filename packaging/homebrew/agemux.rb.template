class Agemux < Formula
  desc "Persistent Codex, Claude, and Grok sessions with built-in account views"
  homepage "https://github.com/Humelo/agemux"
  url "https://github.com/Humelo/agemux/archive/refs/tags/v0.1.29.tar.gz"
  sha256 "9c826e203bb1581474fec212e373adb07763ac92b56dcb4a45cd27ef97899538"
  license "MIT"

  depends_on "go" => :build
  depends_on "shpool"

  def install
    system "go", "build", *std_go_args(output: bin/"agemux"), "./cmd/agemux"
  end

  test do
    assert_match "agemux", shell_output("#{bin}/agemux --help")
    assert_match "Claude accounts 0.1.29", shell_output("#{bin}/agemux claude-accounts version")
  end
end
