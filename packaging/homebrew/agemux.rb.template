class Agemux < Formula
  desc "Persistent Codex, Claude, and Grok sessions with built-in account views"
  homepage "https://github.com/Humelo/agemux"
  url "https://github.com/Humelo/agemux/archive/refs/tags/v0.1.28.tar.gz"
  sha256 "36581d140e4a736f3570c01f055c08949d6e5e36d7ec28651e4730eafd2de2d4"
  license "MIT"

  depends_on "go" => :build
  depends_on "shpool"

  def install
    system "go", "build", *std_go_args(output: bin/"agemux"), "./cmd/agemux"
  end

  test do
    assert_match "agemux", shell_output("#{bin}/agemux --help")
    assert_match "Claude accounts 0.1.28", shell_output("#{bin}/agemux claude-accounts version")
  end
end
